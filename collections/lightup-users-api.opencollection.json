          "info": {
            "name": "Get existing application users",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.{clusterId}.lightup.ai/api/v0/users/",
            "headers": [
              {
                "name": "authorization",
                "value": ""
              }
            ]
          },
          "docs": "Get existing application users"
        },
        {
          "info": {
            "name": "Invite user to the application",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.{clusterId}.lightup.ai/api/v0/users/",
            "headers": [
              {
                "name": "authorization",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Invite user to the application"
        },
        {
